VITE_API_URL=http://localhost:5001/api
VITE_SUPABASE_URL=https://your-project.supabase.co
# Public anon/publishable key only. Never put service_role or secret keys in VITE_ variables.
VITE_SUPABASE_ANON_KEY=your-public-anon-key

# Keep false until Google OAuth is configured and validated end to end.
VITE_GOOGLE_AUTH_ENABLED=false

# In Supabase, enable Email + Confirm email and configure SMTP for public delivery.
# Add the exact app origins to the redirect allow list, including:
# http://localhost:5173/auth/callback** (development only)
# https://your-app.example/auth/callback** (replace with your deployed origin)
# Keep /login and /resetar-senha redirects while older emailed links may still be in use.
