NODE_ENV=development
PORT=5001
FRONTEND_URL=http://localhost:5173
TRUST_PROXY_HOPS=0
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_ANON_KEY=
IMPORT_WORKER_ENABLED=true
# Private pilot remains usable without payment or external AI.
BILLING_ENABLED=false
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
AI_ENABLED=false
AI_PROVIDER=groq
AI_MODEL=openai/gpt-oss-20b
# Groq (not xAI/Grok): CSV or a JSON array of keys, tried in configured order.
# GROQ_API_KEY and legacy AI_API_KEY are also accepted and deduplicated.
# Rotation handles rejected credentials or explicitly key-scoped restrictions.
# Shared/unknown 429 quotas stop the Groq pool until Retry-After; extra keys do not multiply free quota.
GROQ_API_KEYS=
GROQ_API_KEY=
AI_API_KEY=
AI_FALLBACK_PROVIDER=
GEMINI_API_KEY=
AI_MODEL_GEMINI=
# Optional local OCR; no financial document is sent to an OCR provider.
# Enable only where these native dependencies are installed (see backend/Dockerfile).
LUME_OCR_ENABLED=false
LUME_TESSERACT_PATH=
LUME_TESSDATA_PATH=
LUME_PDFTOPPM_PATH=
# Migration tooling only; never expose these variables to Vite.
DATABASE_URL=
MIGRATION_BACKUP_PATH=
CONFIRM_MIGRATION_TARGET=
# Read-only metadata inspection output. Existing files are never overwritten.
SUPABASE_INSPECTION_PATH=
